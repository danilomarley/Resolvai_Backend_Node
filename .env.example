# Copie para .env e preencha. O .env nunca deve ser versionado (repositório público).
PORT=5172
HOST=0.0.0.0
LOG_LEVEL=info

# Connection string do PostgreSQL do Supabase (Project Settings -> Database), no formato URL.
# Caracteres especiais da senha precisam de URL encoding.
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_COMMAND_TIMEOUT_SECONDS=30

# Project Settings -> API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret>
SUPABASE_AUDIENCE=authenticated
# Bucket público das fotos dos pedidos (db/scripts/012_create_bucket_pedidos.sql).
SUPABASE_STORAGE_BUCKET=pedidos

# Chat de IA da criação de pedido (#69). Sem chave, POST /api/v1/orders/assistant responde 503.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Origens do front separadas por vírgula. Vazio desliga o CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
